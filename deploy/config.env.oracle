# Starting config for an Oracle Cloud Ampere A1 instance (4 OCPU / 24 GB).
#
# These are deliberately CONSERVATIVE, not the maximum the box can push. A
# datacenter link can hold far more parallel connections open than a home line
# can, but the limit that bites first is not the link -- it is Telegram's
# per-account rate limit on upload.GetFile. Exceed it and you get FloodWait; keep
# exceeding it from a fresh datacenter IP on a *user* session and the risk stops
# being a 30-second wait and becomes a limited account.
#
# Ramp up from here using the procedure in deploy/README.md. Do not start at the
# ceiling.
#
# ---- The multiplication that matters --------------------------------------
#
# DOWNLOAD_WORKERS is per file, not global: helpers/fastdl.py opens that many
# media sessions inside *each* concurrent download. So
#
#     simultaneous GetFile streams = MAX_CONCURRENT_DOWNLOADS x DOWNLOAD_WORKERS
#
# MAX_CONCURRENT_DOWNLOADS is pinned to 1 below precisely so that product stays
# equal to DOWNLOAD_WORKERS and one number governs your exposure. Raising both
# at once is how you get 32 streams while believing you configured 16.

# ---- Secrets: fill these in, they are never committed ----------------------
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_STRING=

# Optional: channel/group that finished downloads get copied to.
FORWARD_CHAT_ID=

# ---- Transfer tuning ------------------------------------------------------

# Parallel connections per file. 8 matches the tuned laptop baseline and is a
# safe place to begin on a new IP. The code's ceiling is 16; earn your way there
# with the benchmark rather than assuming the link is the only constraint.
DOWNLOAD_WORKERS=8

# Keep at 1. This is what stops DOWNLOAD_WORKERS from multiplying (see above).
# Throughput comes from workers within one file, not from more files at once --
# the account-level rate limit is shared either way, so parallel files buy
# nothing and cost predictability.
MAX_CONCURRENT_DOWNLOADS=1

# Concurrent transfers Pyrogram permits; also gates uploads back to Telegram.
MAX_CONCURRENT_TRANSMISSIONS=4

# Uploads in flight. 2 lets one upload overlap the next download without
# stacking outbound streams.
MAX_CONCURRENT_UPLOADS=2

# Items in flight (downloading + waiting + uploading). At 2 this is exactly one
# download alongside one upload -- opposite directions of the link, so they cost
# each other almost nothing. Peak disk is about PIPELINE_DEPTH x file size.
PIPELINE_DEPTH=2

# Pause between batch groups. Slightly above the default of 10 because a fresh
# datacenter IP has no reputation with Telegram yet. Lower it only after you have
# watched a long batch finish with zero floods.
FLOOD_WAIT_DELAY=15

# ---- Storage --------------------------------------------------------------

# Staging directory INSIDE the container. deploy/docker-compose.vps.yml binds
# this to /var/lib/rcdl/tmp on the host so files land on the big volume and not
# in the container's overlay filesystem.
DOWNLOAD_DIR=/data/tmp

# Reserve kept free before a download is allowed to start. Raised from the
# 2 GB default now that there is room for it.
DISK_MIN_FREE_GB=20

# Copy unprotected posts server-side. Telegram moves those bytes internally, so
# they cost no bandwidth AND no GetFile calls -- this is free speed with zero
# FloodWait exposure. Always leave it on.
SERVER_SIDE_COPY=1
